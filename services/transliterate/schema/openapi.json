            "type": "object"
          },
          "romanization_system": {
            "title": "Romanization System",
            "type": "string"
          },
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/TokenModel"
            },
            "title": "Tokens",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
