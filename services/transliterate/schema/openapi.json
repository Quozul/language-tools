            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "word_spacing": {
            "default": true,
            "title": "Word Spacing",
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "language"
        ],
        "title": "AnnotateRequest",
        "type": "object"
      },
